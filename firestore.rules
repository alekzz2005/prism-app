rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ───────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isInstructor() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Instructor';
    }

    // ── Users collection ──────────────────────────────────────────────
    match /users/{uid} {
      // Users can read/write their own document; Instructors can read user profiles (e.g. resolving email to UID)
      allow read: if isSignedIn() && (request.auth.uid == uid || isInstructor());
      allow write: if isSignedIn() && request.auth.uid == uid;
      
      // User In-App Notifications
      match /notifications/{notifId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn() && (request.auth.uid == uid || isInstructor());
        allow update, delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ── Password Resets / OTPs ─────────────────────────────────────────
    match /password_resets/{email} {
      allow read, write: if false;
    }

    // ── Sessions collection ───────────────────────────────────────────
    match /sessions/{sessionId} {
      // Instructors can create official sessions.
      // Students may create their own practice sessions (must match auth.uid, isPractice == true, and feedbackStatus == 'Released')
      allow create: if isSignedIn() && (
        isInstructor() ||
        (
          (request.resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.token.email) &&
          request.resource.data.feedbackStatus == 'Released' &&
          request.resource.data.isPractice == true
        )
      );
      
      // Students can read their own sessions ONLY after feedback is Released (Pre-Release Feedback Quarantine)
      // Instructors can read ALL sessions
      allow read: if isSignedIn() && (
        (
          (resource.data.userId == request.auth.uid || resource.data.userId == request.auth.token.email) &&
          resource.data.feedbackStatus == 'Released'
        ) ||
        isInstructor()
      );
      
      // Instructors have full update rights.
      // Students may update ONLY their own practice sessions to populate generated AI feedback.
      // Strictly restricted to feedback fields; cannot alter scores, angles, userId, isPractice, or feedbackStatus.
      allow update: if isInstructor() || (
        isSignedIn() &&
        (resource.data.userId == request.auth.uid || resource.data.userId == request.auth.token.email) &&
        resource.data.isPractice == true &&
        resource.data.feedbackStatus == 'Released' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'aiFeedbackText',
          'aiFeedbackOriginal',
          'aiValidationStatus',
          'aiValidationNotes'
        ])
      );
      
      // Instructors only can delete session documents
      allow delete: if isInstructor();
    }

    // ── Live Sessions (Two-Device Architecture & WebRTC Signaling) ──────
    // The instructor (Remote) and camera node read/write to this document
    // and subcollections (ice_candidates for WebRTC P2P signaling). Instructors only.
    match /live_sessions/{instructorId} {
      allow read, write: if isInstructor();

      match /{allChildren=**} {
        allow read, write: if isInstructor();
      }
    }

    // ── Instructor Roster & Sections ──────────────────────────────────
    // Instructors manage their Sections
    match /instructor_roster/{instructorId}/sections/{sectionId} {
      allow read, write: if isSignedIn() && request.auth.uid == instructorId && isInstructor();
    }
    
    // Instructors manage their CSV imported student roster inside Sections
    match /instructor_roster/{instructorId}/sections/{sectionId}/students/{studentDoc} {
      allow read, write: if isSignedIn() && request.auth.uid == instructorId && isInstructor();
    }
  }
}
